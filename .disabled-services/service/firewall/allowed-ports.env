# Inbound allowlist for Docker host enforcement.
#
# Policy: all inbound connections are dropped by default.
# Only the allowlist classes below are permitted.
# Undefined inbound ports are dropped by firewall/scripts/apply-docker-host-firewall.sh.
# Keep this aligned with security-stack.compose.yml and IPFire RED -> GREEN rules.

# Traffic originating from Docker/service subnets is allowed out; inbound is still allowlisted below.
INTERNAL_CIDRS="10.77.0.0/24"

# Public services reachable from any approved upstream source.
PUBLIC_TCP_PORTS="80"
PUBLIC_UDP_PORTS=""

# Endpoint/collector ingestion ports. Restrict these to protected endpoint networks.
ENDPOINT_CIDRS="10.77.0.0/24 192.168.0.0/16 172.16.0.0/12"
ENDPOINT_TCP_PORTS="1515 8000 5514"
ENDPOINT_UDP_PORTS="1514 12201 5514"

# Administrative UI/API ports. Restrict these to admin workstations or VPN ranges.
ADMIN_CIDRS="10.77.0.0/24"
ADMIN_TCP_PORTS="3001 3002 5001 55000 5601 8200 8889 9000 9001 9200 9392 9443"
ADMIN_UDP_PORTS=""

# Local DNS is bound to 127.0.0.1 by default. Add only if you deliberately expose it.
DNS_CIDRS="127.0.0.1/32"
DNS_TCP_PORTS="1053"
DNS_UDP_PORTS="1053"
