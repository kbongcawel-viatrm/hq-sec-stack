# Copy to .env and replace lab defaults before exposing services.

SECSTACK_UID=1000
SECSTACK_GID=1000
SENSOR_INTERFACE=eth0
# Keep SECDNS_IPV4 and FQDN_PROXY_IPV4 inside SECNET_CIDR.
SECNET_CIDR=10.77.0.0/24
SECNET_GATEWAY=10.77.0.1

COREDNS_VERSION=1.11.3
CADDY_VERSION=2.8.4-alpine
SECDNS_HOST_IP=127.0.0.1
SECDNS_PORT=1053
SECDNS_IPV4=10.77.0.53
FQDN_PROXY_IPV4=10.77.0.80
FQDN_HTTP_HOST_IP=0.0.0.0
FQDN_HTTP_PORT=80

VAULT_VERSION=1.18
VAULT_HTTP_PORT=8200
VAULT_ADDR=http://vault:8200
VAULT_KV_MOUNT=secret
# Do not commit real Vault tokens. Set this in .env after Vault init/unseal.
VAULT_ROTATOR_TOKEN=
VAULT_ROTATION_DAY=1
VAULT_ROTATION_CHECK_SECONDS=21600
VAULT_ROTATION_RUN_ON_STARTUP=false

BACKUP_ALPINE_VERSION=3.20
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_RUN_ON_STARTUP=true
BACKUP_ONCE=false

# Trivy v0.70.0 is pinned because v0.69.4-v0.69.6 were affected by a 2026 supply-chain advisory.
TRIVY_VERSION=0.70.0
TRIVY_SCAN_INTERVAL_SECONDS=86400
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_EXIT_CODE=0
TRIVY_RUN_ON_STARTUP=true
TRIVY_SCAN_ONCE=false

FLUENT_BIT_VERSION=3.2.10
PYTHON_ALPINE_VERSION=3.12-alpine
CURL_VERSION=8.10.1
LOG_ASSESSMENT_INTERVAL_SECONDS=3600
LOG_ASSESSMENT_RUN_ON_STARTUP=true
GRAYLOG_GELF_ADDRESS=127.0.0.1

WAZUH_VERSION=4.14.5
WAZUH_INDEXER_PORT=9200
WAZUH_EVENTS_PORT=1514
WAZUH_ENROLLMENT_PORT=1515
WAZUH_API_PORT=55000
WAZUH_DASHBOARD_PORT=5601
WAZUH_DASHBOARD_USERNAME=admin
WAZUH_DASHBOARD_PASSWORD=SecretPassword
WAZUH_INDEXER_JAVA_OPTS=-Xms1g -Xmx1g
WAZUH_FILEBEAT_SSL_VERIFICATION_MODE=none

GRAYLOG_VERSION=7.0.6
MONGO_VERSION=7.0
GRAYLOG_HTTP_PORT=9000
GRAYLOG_HTTP_EXTERNAL_URI=http://localhost:9000/
GRAYLOG_API_URL=http://graylog:9000/api
GRAYLOG_ROOT_USERNAME=admin
GRAYLOG_ROOT_PASSWORD=admin
GRAYLOG_GELF_UDP_PORT=12201
GRAYLOG_SYSLOG_TCP_PORT=5514
GRAYLOG_SYSLOG_UDP_PORT=5514
GRAYLOG_PASSWORD_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# Default Graylog admin password is "admin"; replace before real use.
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
GRAYLOG_DATANODE_JAVA_OPTS=-Xms1g -Xmx1g

SURICATA_VERSION=7.0
SURICATA_RUN_USER=suricata
SURICATA_RUN_GROUP=suricata
ZEEK_VERSION=lts

THEHIVE_VERSION=5
THEHIVE_HTTP_PORT=9001
THEHIVE_JVM_OPTS=-Xms512m -Xmx1g

SHUFFLE_VERSION=1.4.0
SHUFFLE_BASE_URL=http://localhost:3001
SHUFFLE_FRONTEND_PORT=3001
SHUFFLE_BACKEND_PORT=5001

VELOCIRAPTOR_VERSION=0.74.2
VELOCIRAPTOR_GUI_PORT=8889
VELOCIRAPTOR_FRONTEND_PORT=8000

ANSIBLE_VERSION=2.16-tools
OSQUERY_VERSION=5.15.0

GREENBONE_IMAGE_TAG=stable
GREENBONE_DATA_TAG=latest
GREENBONE_GSA_TAG=stable-slim
GREENBONE_CONFIG_TAG=latest
GREENBONE_FEED_RELEASE=24.10
GREENBONE_HTTPS_PORT=9443
GREENBONE_GSA_PORT=9392
GREENBONE_ADMIN_USER=admin
GREENBONE_ADMIN_PASSWORD=admin
