# HQ Security Stack local Suricata IDS rules.
# SID range: 9000001-9000999.

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC Suspicious PowerShell user agent"; flow:to_server,established; http.user_agent; content:"PowerShell"; nocase; classtype:trojan-activity; sid:9000001; rev:2;)

alert dns $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC Suspicious dynamic DNS lookup"; dns.query; pcre:"/((duckdns|no-ip|dynu|hopto|zapto|servehttp|serveftp|ddns)\.)/i"; classtype:trojan-activity; sid:9000002; rev:2;)

alert tcp $HOME_NET any -> $EXTERNAL_NET [4444,5555,6666,7777,8080,8443,9001] (msg:"HQSEC Suspicious outbound callback port"; flow:to_server,established; classtype:trojan-activity; sid:9000003; rev:2;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HQSEC Suspicious web exploit string"; flow:to_server,established; http.uri; pcre:"/(cmd=|powershell|wget|curl|\.env|\/etc\/passwd|wp-config\.php|id_rsa)/i"; classtype:web-application-attack; sid:9000004; rev:2;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC PowerShell download cradle over HTTP"; flow:to_server,established; http.uri; pcre:"/(downloadstring|invoke-webrequest|invoke-restmethod|frombase64string|iex|encodedcommand)/i"; classtype:trojan-activity; sid:9000005; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC Suspicious script-capable tool user agent"; flow:to_server,established; http.user_agent; pcre:"/(powershell|pwsh|curl|wget|python-requests|go-http-client|winhttp|bitsadmin|certutil)/i"; classtype:trojan-activity; sid:9000006; rev:1;)

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC TLS SNI to suspicious dynamic DNS provider"; flow:to_server,established; tls.sni; pcre:"/(\.duckdns\.org|\.no-ip\.(org|com|biz)|\.dynu\.(com|net)|\.hopto\.org|\.zapto\.org|\.servehttp\.com|\.serveftp\.com)/i"; classtype:trojan-activity; sid:9000007; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC Possible outbound reverse shell text"; flow:to_server,established; content:"/bin/sh"; nocase; classtype:trojan-activity; sid:9000008; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC Possible outbound netcat shell activity"; flow:to_server,established; pcre:"/(nc\.exe|ncat|netcat|bash -i|cmd\.exe|powershell\.exe)/i"; classtype:trojan-activity; sid:9000009; rev:1;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"HQSEC Potential TCP SYN scan against HOME_NET"; flags:S; flow:stateless; detection_filter:track by_src, count 20, seconds 60; classtype:attempted-recon; sid:9000010; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HQSEC Credential or secret file probing"; flow:to_server,established; http.uri; pcre:"/(\/\.env|\/\.git\/config|\/id_rsa|\/config\.json|\/secrets|\/backup|\/db\.sql|\/dump\.sql)/i"; classtype:web-application-attack; sid:9000011; rev:1;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"HQSEC Common web shell parameter observed"; flow:to_server,established; http.uri; pcre:"/(\?|&)(cmd|exec|command|powershell|passthru|shell|system)=/i"; classtype:web-application-attack; sid:9000012; rev:1;)

alert dns $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC DNS query for possible tunneling domain length"; dns.query; pcre:"/^[A-Za-z0-9+\/_-]{45,}\./"; classtype:bad-unknown; sid:9000013; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET [6667,6697,7000] (msg:"HQSEC Possible IRC bot C2 outbound"; flow:to_server,established; classtype:trojan-activity; sid:9000014; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET [8333,18333,9333,30303] (msg:"HQSEC Cryptocurrency or blockchain peer connection from monitored host"; flow:to_server,established; classtype:policy-violation; sid:9000015; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC Possible malware retrieval by script extension"; flow:to_server,established; http.uri; pcre:"/\.(ps1|psm1|vbs|js|jse|hta|scr|dll|exe)(\?|$)/i"; classtype:trojan-activity; sid:9000016; rev:1;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"HQSEC Wazuh or OSSEC service control string crossing network"; flow:to_server,established; pcre:"/(stop-service|sc stop|sc delete|remove-service).*(wazuh|ossec|sysmon|eventlog)/i"; classtype:attempted-admin; sid:9000017; rev:1;)
