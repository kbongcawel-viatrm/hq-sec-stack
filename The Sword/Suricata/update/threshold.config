# Add Suricata threshold/suppress rules here after baseline tuning.

# Keep repetitive script/user-agent detections useful without flooding Graylog.
threshold gen_id 1, sig_id 9000001, type limit, track by_src, count 5, seconds 300
threshold gen_id 1, sig_id 9000006, type limit, track by_src, count 10, seconds 300

# Scan detections can be noisy on lab networks; keep a readable signal.
threshold gen_id 1, sig_id 9000010, type limit, track by_src, count 3, seconds 300

# Dynamic DNS and suspicious callback ports should still page through regularly,
# but avoid repeating every packet in a long session.
threshold gen_id 1, sig_id 9000002, type limit, track by_src, count 5, seconds 300
threshold gen_id 1, sig_id 9000003, type limit, track by_src, count 5, seconds 300
