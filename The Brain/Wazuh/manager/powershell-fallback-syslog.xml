<!--
  Add this remote block to the Wazuh manager ossec.conf to receive
  PowerShell fallback collector events when the endpoint agent is removed.
  Keep it on a dedicated port so normal Wazuh agent traffic remains on 1514/udp.
-->
<remote>
  <connection>syslog</connection>
  <port>1516</port>
  <protocol>udp</protocol>
  <allowed-ips>0.0.0.0/0</allowed-ips>
  <local_ip>0.0.0.0</local_ip>
</remote>
