<group name="hq-sec-stack,windows,powershell,sysmon,fim,persistence,network,agent-monitoring,">
  <rule id="100099" level="6">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$</field>
    <description>PowerShell process execution observed</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100100" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-enc|-encodedcommand|downloadstring|iex|invoke-expression|bypass|hidden|nop</field>
    <description>Suspicious PowerShell command line detected</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100101" level="9">
    <if_group>windows,powershell,</if_group>
    <field name="win.system.eventID">4104</field>
    <match>Invoke-Expression|DownloadString|FromBase64String|Add-MpPreference|Set-MpPreference|New-Object Net.WebClient|Reflection.Assembly|AmsiUtils</match>
    <description>PowerShell script block contains suspicious execution, download, or defense-evasion behavior</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100108" level="7">
    <if_group>windows,security,</if_group>
    <field name="win.system.eventID">4688</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$</field>
    <description>PowerShell process creation from Windows Security auditing</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100109" level="10">
    <if_sid>100108</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-enc|-encodedcommand|downloadstring|invoke-webrequest|\biwr\b|\biex\b|invoke-expression|bypass|hidden|frombase64string|amsiutils</field>
    <description>Suspicious PowerShell command from Windows Security process creation auditing</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100105" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\certutil\.exe$|\\bitsadmin\.exe$|\\mshta\.exe$|\\regsvr32\.exe$|\\rundll32\.exe$|\\wmic\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)http|https|javascript:|scrobj\.dll|urlcache|-decode|process call create</field>
    <description>Suspicious LOLBin execution detected</description>
    <mitre><id>T1218</id></mitre>
  </rule>

  <rule id="100106" level="9">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create|/change|/ru\s+system|/sc\s+onlogon|/sc\s+onstart</field>
    <description>Scheduled task creation or modification detected</description>
    <mitre><id>T1053.005</id></mitre>
  </rule>

  <rule id="100107" level="8">
    <if_group>sysmon_event3</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$|\\cmd\.exe$|\\mshta\.exe$|\\rundll32\.exe$|\\regsvr32\.exe$</field>
    <description>Suspicious administrative or LOLBin process initiated a network connection</description>
    <mitre><id>T1105</id></mitre>
  </rule>

  <rule id="100110" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\sc\.exe$|\\powershell\.exe$|\\pwsh\.exe$|\\net\.exe$|\\net1\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(stop|delete|disable|remove-service|stop-service|set-service).*(wazuh|ossec|sysmon|eventlog)</field>
    <description>Attempt to stop, remove, or disable endpoint telemetry service</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <rule id="100102" level="12">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\\Windows\\System32\\drivers\\etc\\hosts$|\\Windows\\System32\\config\\SAM$|\\Windows\\System32\\config\\SYSTEM$|\\Windows\\System32\\config\\SECURITY$|\\Windows\\System32\\GroupPolicy\\|\\Windows\\System32\\Tasks\\|\\Start Menu\\Programs\\Startup\\|\\Documents\\WindowsPowerShell\\|\\Documents\\PowerShell\\|\\ProgramData\\HQSec\\PowerShellLogs\\</field>
    <description>Critical Windows file integrity change</description>
    <mitre><id>T1565.001</id></mitre>
  </rule>

  <rule id="100111" level="11">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\\Program Files(?: \(x86\))?\\ossec-agent\\|\\Program Files(?: \(x86\))?\\Wazuh\\|\\Program Files\\Sysmon\\|\\ProgramData\\HQSec\\PowerShellLogs\\Collect-PowerShellActivity\.ps1$</field>
    <description>Endpoint monitoring or fallback collector file integrity change</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>

  <rule id="100103" level="10">
    <if_group>windows,registry,</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Run\\|\\RunOnce\\|\\Winlogon\\Shell|\\Image File Execution Options\\|\\Services\\|\\Windows Defender\\Exclusions\\</field>
    <description>Registry persistence or security-control modification detected</description>
    <mitre><id>T1547</id></mitre>
  </rule>

  <rule id="100104" level="9">
    <if_group>suricata,</if_group>
    <field name="alert.signature" type="pcre2">(?i)c2|command and control|malware|trojan|exploit|scan</field>
    <description>Suricata suspicious network activity</description>
  </rule>

  <rule id="100120" level="6">
    <decoded_as>hqsec-powershell-fallback</decoded_as>
    <field name="collector">hq-sec-powershell-task</field>
    <description>Fallback PowerShell collector event received after direct Wazuh agent path</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100121" level="9">
    <if_sid>100120</if_sid>
    <field name="source_type" type="pcre2">powershell_eventlog|powershell_transcript|security_process_creation|sysmon_process_creation</field>
    <description>PowerShell command captured by fallback scheduled-task collector</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100124" level="8">
    <if_sid>100120</if_sid>
    <field name="source_type">powershell_transcript</field>
    <description>PowerShell transcript content captured by fallback scheduled-task collector</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100122" level="12">
    <if_sid>100120</if_sid>
    <field name="suspicious">1</field>
    <description>Suspicious PowerShell command captured by fallback scheduled-task collector</description>
    <mitre><id>T1059.001</id></mitre>
  </rule>

  <rule id="100123" level="12">
    <if_sid>100120</if_sid>
    <field name="command" type="pcre2">(?i)(stop|delete|disable|remove-service|stop-service|set-service).*(wazuh|ossec|sysmon|eventlog)</field>
    <description>Fallback collector detected attempt to stop or remove monitoring service</description>
    <mitre><id>T1562.001</id></mitre>
  </rule>
</group>
