<group name="hq-sec-stack,windows,powershell,sysmon,fim,network,">
  <rule id="100100" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$|\\pwsh\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)-enc|-encodedcommand|downloadstring|iex|invoke-expression|bypass|hidden|nop</field>
    <description>Suspicious PowerShell command line detected</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100101" level="8">
    <if_group>windows,powershell,</if_group>
    <field name="win.system.eventID">4104</field>
    <match>Invoke-Expression|DownloadString|FromBase64String|Add-MpPreference|Set-MpPreference|New-Object Net.WebClient</match>
    <description>PowerShell script block contains suspicious execution or download behavior</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100102" level="12">
    <if_group>syscheck</if_group>
    <field name="file" type="pcre2">(?i)\\Windows\\System32\\drivers\\etc\\hosts$|\\Windows\\System32\\config\\SAM$|\\Windows\\System32\\GroupPolicy\\</field>
    <description>Critical Windows file integrity change</description>
    <mitre>
      <id>T1565.001</id>
    </mitre>
  </rule>

  <rule id="100103" level="10">
    <if_group>windows,registry,</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\Run\\|\\RunOnce\\|\\Winlogon\\Shell|\\Image File Execution Options\\</field>
    <description>Registry persistence location modified</description>
    <mitre>
      <id>T1060</id>
    </mitre>
  </rule>

  <rule id="100104" level="9">
    <if_group>suricata,</if_group>
    <field name="alert.signature" type="pcre2">(?i)c2|command and control|malware|trojan|exploit|scan</field>
    <description>Suricata suspicious network activity</description>
  </rule>
</group>
