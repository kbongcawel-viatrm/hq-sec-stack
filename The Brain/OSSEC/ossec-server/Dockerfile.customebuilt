ARG OSSEC_VERSION=3.8.0

FROM debian:bookworm-slim AS builder

ARG OSSEC_VERSION

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        build-essential \
        make \
        zlib1g-dev \
        libpcre2-dev \
        libevent-dev \
        libssl-dev \
        libsystemd-dev \
        libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src

RUN curl -fsSL "https://github.com/ossec/ossec-hids/archive/refs/tags/${OSSEC_VERSION}.tar.gz" -o ossec-hids.tar.gz \
    && tar -xzf ossec-hids.tar.gz \
    && mv "ossec-hids-${OSSEC_VERSION}" ossec-hids

COPY preloaded-vars.conf /usr/src/ossec-hids/etc/preloaded-vars.conf

RUN cd /usr/src/ossec-hids \
    && PCRE2_SYSTEM=yes ZLIB_SYSTEM=yes ./install.sh \
    && cp -a /var/ossec /opt/ossec-seed

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        net-tools \
        procps \
        zlib1g \
        libpcre2-8-0 \
        libevent-2.1-7 \
        libssl3 \
        libsystemd0 \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group
COPY --from=builder /opt/ossec-seed /opt/ossec-seed
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod 755 /usr/local/bin/docker-entrypoint.sh \
    && mkdir -p /var/ossec

EXPOSE 1514/udp 1515/tcp

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
